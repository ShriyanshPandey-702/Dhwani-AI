# Dhwani AI — Backend Configuration Template
# Copy to .env and configure values

DATABASE_URL=sqlite+aiosqlite:///./dhwaniai.db
REDIS_URL=redis://localhost:6379
JWT_SECRET=local-dev-secret-not-for-production-1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_ENV=development
APP_NAME=Dhwani AI

# Third-Party Live Audio & Synthetic Voice Providers
DEEPGRAM_API_KEY=
MODULATE_API_KEY=
STT_PROVIDER=deepgram
SYNTHETIC_PROVIDER=modulate

# Telephony / Asterisk ARI
ARI_USER=voiceshield
ARI_PASSWORD=<ARI_PASSWORD>
