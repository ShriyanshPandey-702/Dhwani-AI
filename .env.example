# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voiceshield:voiceshield@localhost:5432/voiceshield

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── ML pipeline ──────────────────────────────────────────────────────────────
# mock    = deterministic demonstration (heuristic DSP, scripted transcript).
# real_ml = load real checkpoints; each stream falls back independently and
#           says so if its model is unavailable.
PIPELINE_MODE=mock
MODEL_DIR=models

# Authenticity (AASIST). Run: python scripts/fetch_models.py
AASIST_VARIANT=AASIST-L
AASIST_CASCADE=true
AASIST_CASCADE_MARGIN=0.25

# Streaming analysis window (AASIST was trained on 64600 samples @ 16 kHz)
ANALYSIS_WINDOW_MS=4038
ANALYSIS_HOP_MS=1000

# Identity (ECAPA-TDNN). Thresholds are UNCALIBRATED for our audio conditions.
ECAPA_VERIFIED_AT=0.60
ECAPA_MISMATCH_BELOW=0.35

# STT (faster-whisper). Leave WHISPER_LANGUAGE empty to auto-detect.
WHISPER_MODEL_SIZE=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=1

ML_DEVICE=auto

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Dhwani AI
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Push (stubbed for MVP) ───────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
